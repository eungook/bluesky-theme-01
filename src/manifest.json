{
  "manifest_version": 3,
  "name": "Color Themes for Bluesky",
  "version": "1.0.0",
  "description": "Adds multiple color themes to Bluesky on the web.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://bsky.app/*"],
  "content_scripts": [
    {
      "matches": ["https://bsky.app/*"],
      "js": ["content/index.js"],
      "css": ["content/theme.css"],
      "run_at": "document_start"
    }
  ]
}
